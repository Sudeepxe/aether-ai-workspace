# ---- Environment & secrets -------------------------------------------------
# Only the example contract is committed (see SPRINT_0_PLAN §15).
.env
.env.*
!.env.example
# Decrypted SOPS output must never be committed (ADR-7.5).
infra/secrets/*.dec.*
infra/secrets/decrypted/

# ---- Generated artifacts rebuilt by CI -------------------------------------
# EXCEPTION (documented per Sprint 0 self-review F-3): packages/contracts/
# holds COMMITTED generated files (OpenAPI spec, TS types) because ADR-9.2
# requires the generated contract to be committed and diffed in CI.
docs/architecture/rendered/
# Locally-rendered portfolio artifacts (e.g. docs/EVALUATION_REPORT.md's
# PDF render) — regenerated on demand, not a source-of-truth file, and
# not meant to accumulate as binary diffs in history.
outputs/

# ---- Docker ----------------------------------------------------------------
compose.override.yml

