# Environment contract (SPRINT_0_PLAN §15). Every variable the system reads
# appears here with a comment and a dev-safe default. Real secrets live only
# in SOPS bundles (infra/secrets/, ADR-7.5) — never in a committed .env.

# --- application -------------------------------------------------------------
AETHER_ENV=dev                 # dev | test | staging | prod
AETHER_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
AETHER_SERVICE_NAME=aether-api

# --- infra services (dev compose profile; used from S1 when adapters land) ---
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether-dev-only    # dev default; prod value comes from SOPS
POSTGRES_DB=aether
MINIO_ROOT_USER=aether
MINIO_ROOT_PASSWORD=aether-dev-only  # dev default; prod value comes from SOPS

# --- data layer (Sprint 1) ----------------------------------------------------
# App runtime connects as the least-privileged app_api role (ADR-8.1,
# subject to RLS); migrations connect separately as the bootstrap role,
# which has DDL rights app_api deliberately doesn't have.
AETHER_DATABASE_URL=postgresql://app_api:app-api-dev-only@localhost:5432/aether
AETHER_DATABASE_MIGRATOR_URL=postgresql://aether:aether-dev-only@localhost:5432/aether
# The worker connects as the separate app_worker role (Sprint 2: outbox
# dispatch) — disjoint grants from app_api, matching ADR-8.1.
AETHER_DATABASE_WORKER_URL=postgresql://app_worker:app-worker-dev-only@localhost:5432/aether
AETHER_REDIS_URL=redis://localhost:6379/0

# --- auth / JWT (Sprint 1, ADR-7.2) -------------------------------------------
# Dev-only Ed25519 signing seed, base64-encoded — safe to commit, protects
# nothing outside the local dev profile. Prod value comes from SOPS.
AETHER_JWT_SIGNING_KEY=ENa+PofIf23y5gFynYezonUkV5iu0pgeEe/PHlqCG4E= # gitleaks:allow
AETHER_JWT_KID=dev-1                 # static in-process key id (ADR-7.2)
AETHER_JWT_ACCESS_TTL_SECONDS=900        # 15 min
AETHER_JWT_REFRESH_TTL_SECONDS=604800    # 7 days
AETHER_JWT_REFRESH_GRACE_SECONDS=30      # same-device replay grace window

# --- email (Sprint 2, ADR-11.1) -----------------------------------------------
# dev profile sends via SMTP against mailpit (already in the dev compose
# stack); "resend" swaps in the managed-API adapter for prod-like profiles.
AETHER_EMAIL_PROVIDER=smtp           # smtp | resend
AETHER_SMTP_HOST=localhost
AETHER_SMTP_PORT=1025
AETHER_EMAIL_SENDER=noreply@aether.local
AETHER_RESEND_API_KEY=               # prod value comes from SOPS, never committed

# --- LLM Router (Sprint 4, ADR-3.5) --------------------------------------------
# Real values come from the SOPS bundle (infra/secrets/dev.enc.yaml),
# never committed here — `make secrets-env` decrypts and exports them.
AETHER_OPENAI_API_KEY=
AETHER_ANTHROPIC_API_KEY=

# --- usage metering & budgets (Sprint 4, §3.2.14) ------------------------------
# cost_microcents units throughout: 1 microcent = 1e-6 US cent = 1e-8 USD.
AETHER_GLOBAL_MONTHLY_BUDGET_MICROCENTS=5000000000       # $50/mo demo cap, NFR-C-1
AETHER_DEFAULT_WORKSPACE_MONTHLY_BUDGET_MICROCENTS=500000000  # $5/workspace/mo default
AETHER_DEFAULT_BUDGET_SOFT_PCT=80
AETHER_ADMISSION_CEILING_COST_PER_1K_MICROCENTS=60000     # conservative worst-case admission estimate
AETHER_ROUTER_MAX_TOKENS=1024
AETHER_ROUTER_MAX_CONCURRENT_PER_PROVIDER=4               # per-provider in-flight generation cap

# --- object storage (Sprint 5, §3.2.13, ADR-3.8) --------------------------------
# Dev-safe defaults matching MINIO_ROOT_USER/MINIO_ROOT_PASSWORD above.
AETHER_OBJECT_STORAGE_ENDPOINT=localhost:9000
AETHER_OBJECT_STORAGE_ACCESS_KEY=aether
AETHER_OBJECT_STORAGE_SECRET_KEY=aether-dev-only
AETHER_OBJECT_STORAGE_SECURE=false
AETHER_OBJECT_STORAGE_BUCKET=aether-documents
AETHER_OBJECT_STORAGE_PRESIGN_TTL_SECONDS=900

# --- malware scanning (Sprint 5, §3.2.7, TB-6) -----------------------------------
AETHER_CLAMAV_HOST=localhost
AETHER_CLAMAV_PORT=3310

# --- grounded chat refusal (Sprint 6/7, ADR-6.4) ----------------------------------
# Gate 1's retrieval-score threshold — real, data-derived (issue #73):
# 50% of the weakest observed positive-match RRF score across the v1
# golden set, against LocalHashEmbeddingAdapter (embedding_version=1).
# Rerun evals/harness/calibrate.py after any real embedding migration.
AETHER_RETRIEVAL_REFUSAL_THRESHOLD=0.0082

# --- observability (Sprint 9, NFR-O-1, §3.8) --------------------------------------
# Empty = tracing is a no-op; set to the otel-collector's OTLP HTTP receiver
# (default http://localhost:4318 in the `observability` compose profile) to enable.
AETHER_OTEL_EXPORTER_OTLP_ENDPOINT=
AETHER_OTEL_TRACE_SAMPLE_RATIO=0.10
AETHER_WORKER_METRICS_PORT=9090
