{
  "uid": "aether-cost",
  "title": "Aether / Cost",
  "tags": ["aether", "cost"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Global spend vs cap (NFR-C-1)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "aether_global_spend_microcents{job=\"aether-worker\"} / aether_global_budget_cap_microcents{job=\"aether-worker\"}",
          "legendFormat": "spend / cap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Settled spend rate (hourly)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(aether_settled_cost_microcents_total{job=\"aether-api\"}[1h])",
          "legendFormat": "settled/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Estimate-vs-actual drift (admission ceiling vs settled)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Systematic drift here means the admission-time ceiling estimate (§3.2.14) is miscalibrated, not that any single request overspent — ticket-grade alert at drift > 5% (§10.4).",
      "targets": [
        {
          "expr": "(rate(aether_admission_estimated_cost_microcents_total{job=\"aether-api\"}[1h]) - rate(aether_settled_cost_microcents_total{job=\"aether-api\"}[1h])) / clamp_min(rate(aether_settled_cost_microcents_total{job=\"aether-api\"}[1h]), 1)",
          "legendFormat": "estimate drift"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    }
  ]
}
